---
// In-flow "Contents" strip built from an article's h2 headings. Replaces the
// 2026-06-17 sticky rail: the site is one centered reading column again
// (CONTEXT.md, "no sidebars"). Shows only when there are at least two sections.
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

{
	toc.length >= 2 && (
		<nav
			aria-label="Contents"
			class="mt-7 flex flex-wrap gap-x-4 gap-y-1 border-y border-rule py-3 font-sans text-sm text-muted"
		>
			<span class="text-[11px] font-semibold uppercase tracking-wider">Contents</span>
			{toc.map((h) => (
				<a href={`#${h.slug}`} class="hover:text-accent">
					{h.text}
				</a>
			))}
		</nav>
	)
}
