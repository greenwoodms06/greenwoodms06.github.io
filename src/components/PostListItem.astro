---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import AuthorshipBadge from './AuthorshipBadge.astro';
import KindBadge from './KindBadge.astro';

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a
	href={`/blog/${post.id}`}
	data-kind={post.data.kind}
	class="group block border-b border-rule-soft py-4 last:border-0"
>
	<div class="flex items-baseline gap-3 font-mono text-xs text-muted">
		<FormattedDate date={post.data.pubDate} />
		<KindBadge kind={post.data.kind} />
		<AuthorshipBadge authorship={post.data.authorship} variant="chip" />
	</div>
	<h3 class="mt-1 text-[19px] font-semibold leading-snug group-hover:text-accent">{post.data.title}</h3>
	{post.data.description && (
		<p class="mt-1 font-sans text-sm leading-relaxed text-muted">{post.data.description}</p>
	)}
</a>
