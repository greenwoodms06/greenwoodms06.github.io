---
// Reader-facing disclosure for AI-assisted content. Human content shows nothing.
interface Props {
	authorship?: 'human' | 'ai';
	variant?: 'chip' | 'note';
}
const { authorship = 'human', variant = 'chip' } = Astro.props;
const isAI = authorship === 'ai';
---

{
	isAI &&
		(variant === 'chip' ? (
			<span class="font-sans text-[11px] uppercase tracking-wider text-accent">AI-assisted</span>
		) : (
			<div class="not-prose mt-4 bg-inset px-3.5 py-2.5 font-sans text-sm leading-relaxed text-muted">
				<strong class="font-semibold text-ink">AI-assisted.</strong> Drafted with AI and
				edited by Scott.
			</div>
		))
}
