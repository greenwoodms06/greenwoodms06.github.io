---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_TAGLINE, NAV, SOCIALS } from '../consts';

// Gallery appears in the nav only once it has something in it.
const nav = (await getCollection('gallery')).length
	? [...NAV.slice(0, 3), { href: '/gallery', label: 'Gallery' }, ...NAV.slice(3)]
	: [...NAV];
const here = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? here === '/' : here.startsWith(href);
---

<header class="border-b border-rule">
	<div class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-4 py-5">
		<div class="flex flex-col gap-0.5">
			<a href="/" class="text-[28px] font-semibold tracking-tight hover:text-accent">{SITE_TITLE}</a>
			<span class="font-sans text-sm text-muted">{SITE_TAGLINE}</span>
		</div>
		<nav class="flex flex-wrap items-center gap-x-5 gap-y-1 font-sans text-[15px] text-muted">
			{
				nav.map((n) => (
					<a
						href={n.href}
						class:list={[
							'hover:text-accent',
							isActive(n.href) && 'font-semibold text-accent',
						]}
					>
						{n.label}
					</a>
				))
			}
			<a href={SOCIALS.github} class="hover:text-accent">GitHub</a>
		</nav>
	</div>
</header>
