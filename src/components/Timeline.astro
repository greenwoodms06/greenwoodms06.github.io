---
// The home-page ledger: everything on the site, grouped by year, newest first,
// with a filter row by source. Rows are title-only on purpose — this is for
// scanning a history, and the section indexes carry the blurbs.
import FilterBar from './FilterBar.astro';
import type { TimelineYear, TimelineGroup } from '../lib/content';

interface Props {
	years: TimelineYear[];
}
const { years } = Astro.props;

const present = new Set<TimelineGroup>(
	years.flatMap((y) => y.items.map((i) => i.group)),
);
const GROUP_LABEL: Record<TimelineGroup, string> = {
	writing: 'Writing',
	projects: 'Projects',
	publications: 'Publications',
	gallery: 'Gallery',
};
const chips = [
	{ value: 'all', label: 'All' },
	...(['writing', 'projects', 'publications', 'gallery'] as TimelineGroup[])
		.filter((g) => present.has(g))
		.map((g) => ({ value: g, label: GROUP_LABEL[g] })),
];
const monthDay = (d: Date) =>
	d.toLocaleDateString('en-us', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section class="mt-14" id="timeline">
	<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule pb-2.5">
		<h2 class="text-2xl font-semibold">Everything, by date</h2>
		<FilterBar
			chips={chips}
			target="#timeline .tl-row"
			attr="data-group"
			groups="#timeline .tl-year"
			label="Filter the timeline"
		/>
	</div>
	{
		years.map((y) => (
			<section
				class="tl-year grid grid-cols-[3rem_minmax(0,1fr)] gap-x-3 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-x-4"
				data-year={y.year}
			>
				<h3 class="sticky top-4 self-start pt-4 font-sans text-sm font-semibold text-muted">
					{y.year}
				</h3>
				<ul class="pt-1">
					{y.items.map((it) => (
						<li
							class="tl-row grid grid-cols-[3.25rem_5rem_minmax(0,1fr)] items-baseline gap-2 border-b border-rule-soft py-2.5 sm:grid-cols-[3.5rem_7rem_minmax(0,1fr)] sm:gap-4"
							data-group={it.group}
						>
							<span class="font-mono text-xs text-muted">
								{!it.yearOnly && (
									<time datetime={it.date.toISOString()}>{monthDay(it.date)}</time>
								)}
							</span>
							<span
								class:list={[
									'font-sans text-[11px] uppercase tracking-wider',
									it.group === 'projects' ? 'text-accent' : 'text-muted',
								]}
							>
								{it.label}
							</span>
							<a
								href={it.href}
								rel={it.external ? 'noopener' : undefined}
								target={it.external ? '_blank' : undefined}
								class="min-w-0 text-[17px] leading-snug hover:text-accent"
							>
								{it.title}
								{it.external && <span aria-hidden="true"> ↗</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</section>
