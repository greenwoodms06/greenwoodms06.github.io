---
// The home-page ledger: everything on the site, grouped by year, newest first,
// with a filter row by source. Rows are title-only on purpose — this is for
// scanning a history, and the section indexes carry the blurbs.
import type { TimelineYear, TimelineGroup } from '../lib/content';

interface Props {
	years: TimelineYear[];
}
const { years } = Astro.props;

const present = new Set<TimelineGroup>(
	years.flatMap((y) => y.items.map((i) => i.group)),
);
const GROUP_LABEL: Record<TimelineGroup, string> = {
	writing: 'Writing',
	projects: 'Projects',
	publications: 'Publications',
	gallery: 'Gallery',
};
const chips = [
	{ value: 'all', label: 'All' },
	...(['writing', 'projects', 'publications', 'gallery'] as TimelineGroup[])
		.filter((g) => present.has(g))
		.map((g) => ({ value: g, label: GROUP_LABEL[g] })),
];
const monthDay = (d: Date) =>
	d.toLocaleDateString('en-us', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section class="mt-12" id="timeline">
	<div class="flex flex-wrap items-baseline justify-between gap-3">
		<h2 class="text-xl font-bold">Everything, by date</h2>
		<div class="flex flex-wrap gap-2" role="group" aria-label="Filter the timeline">
			{
				chips.map((c) => (
					<button
						type="button"
						data-filter={c.value}
						aria-pressed={c.value === 'all' ? 'true' : 'false'}
						class="tl-chip rounded-full border border-zinc-300 px-3 py-1 text-sm transition hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
					>
						{c.label}
					</button>
				))
			}
		</div>
	</div>
	{
		years.map((y) => (
			<section class="tl-year mt-6" data-year={y.year}>
				<h3 class="border-b border-zinc-200 pb-1 font-mono text-sm font-semibold text-zinc-500">
					{y.year}
				</h3>
				<ul class="mt-2">
					{y.items.map((it) => (
						<li
							class="tl-row flex items-baseline gap-3 py-1.5"
							data-group={it.group}
						>
							<span class="w-14 shrink-0 font-mono text-xs text-zinc-400">
								{!it.yearOnly && (
									<time datetime={it.date.toISOString()}>{monthDay(it.date)}</time>
								)}
							</span>
							<span
								class:list={[
									'w-24 shrink-0 font-mono text-[0.65rem] uppercase tracking-wide',
									it.group === 'publications' ? 'text-zinc-500' : 'text-accent',
								]}
							>
								{it.label}
							</span>
							<a
								href={it.href}
								rel={it.external ? 'noopener' : undefined}
								target={it.external ? '_blank' : undefined}
								class="min-w-0 font-medium hover:text-accent"
							>
								{it.title}
								{it.external && <span aria-hidden="true"> ↗</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</section>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.tl-chip');
	const rows = document.querySelectorAll<HTMLElement>('#timeline .tl-row');
	const years = document.querySelectorAll<HTMLElement>('#timeline .tl-year');
	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const want = chip.dataset.filter;
			chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
			rows.forEach((row) => {
				row.classList.toggle('hidden', !(want === 'all' || row.dataset.group === want));
			});
			years.forEach((y) => {
				const any = y.querySelectorAll('.tl-row:not(.hidden)').length > 0;
				y.classList.toggle('hidden', !any);
			});
		});
	});
</script>
