---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import PostListItem from '../../components/PostListItem.astro';
import { sortByDateDesc, isPublished, displayTags } from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const posts = (await getCollection('posts')).filter(isPublished);
	const tags = new Set<string>();
	[...projects, ...posts].forEach((e) =>
		displayTags(e).forEach((t) => tags.add(t)),
	);
	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			projects: projects.filter((p) => displayTags(p).includes(tag)),
			posts: sortByDateDesc(
				posts.filter((p) => displayTags(p).includes(tag)),
				'pubDate',
			),
		},
	}));
}

const { tag, projects, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Everything tagged ${tag}.`}>
	<h1 class="text-3xl font-semibold">#{tag}</h1>
	{
		projects.length > 0 && (
			<section class="mt-8">
				<h2 class="border-b border-rule pb-1 font-sans text-sm font-semibold text-muted">Projects</h2>
				<div>
					{projects.map((p) => (
						<ProjectRow project={p} />
					))}
				</div>
			</section>
		)
	}
	{
		posts.length > 0 && (
			<section class="mt-8">
				<h2 class="border-b border-rule pb-1 font-sans text-sm font-semibold text-muted">Writing</h2>
				<div>
					{posts.map((p) => (
						<PostListItem post={p} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>
