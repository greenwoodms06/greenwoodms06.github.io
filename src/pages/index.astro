---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import {
	isPublished,
	pinnedThenByDate,
	groupByYear,
	KIND_LABEL,
	type TimelineItem,
} from '../lib/content';
import { publications, PUBLICATION_TYPE_LABEL } from '../data/publications';

const allProjects = await getCollection('projects');
const allPosts = (await getCollection('posts')).filter(isPublished);
const allGallery = await getCollection('gallery');

// Pinned projects: the only images on the home page.
const pinned = pinnedThenByDate(
	allProjects.filter((p) => p.data.featured),
	'date',
).slice(0, 4);

// The ledger: one entry per thing, on its original date (not updatedDate —
// this is a history, and revisions are visible on the thing itself).
const items: TimelineItem[] = [
	...allPosts.map((p) => ({
		title: p.data.title,
		href: `/blog/${p.id}`,
		group: 'writing' as const,
		label: KIND_LABEL[p.data.kind],
		date: p.data.pubDate,
	})),
	...allProjects.map((p) => ({
		title: p.data.title,
		href: `/projects/${p.id}`,
		group: 'projects' as const,
		label: 'Project',
		date: p.data.date,
	})),
	...publications.map((p) => ({
		title: p.title,
		href: `/publications#${p.id}`,
		group: 'publications' as const,
		label: PUBLICATION_TYPE_LABEL[p.type],
		date: new Date(Date.UTC(p.year, 0, 1)),
		yearOnly: true,
	})),
	...allGallery.map((g) => ({
		title: g.data.title,
		href: g.data.href,
		group: 'gallery' as const,
		label: g.data.source,
		date: g.data.date,
		external: true,
	})),
];
const years = groupByYear(items);
---

<BaseLayout>
	<h1 class="sr-only">On… — a running history of what Scott Greenwood has built, written, and published</h1>
	<p class="max-w-[640px] text-[19px] leading-relaxed">
		A running history of what I've built, written, and published — nuclear
		simulation, graphics, Unreal Engine, and the occasional rabbit hole.{' '}
		<a href="/about" class="text-accent underline decoration-accent-soft underline-offset-4 hover:decoration-accent">About me</a>.
	</p>

	{
		pinned.length > 0 && (
			<section class="mt-10">
				<h2 class="font-sans text-xs font-semibold uppercase tracking-wider text-muted">Pinned projects</h2>
				<div class="mt-3 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{pinned.map((p) => (
						<ProjectCard project={p} />
					))}
				</div>
			</section>
		)
	}

	<Timeline years={years} />
</BaseLayout>
