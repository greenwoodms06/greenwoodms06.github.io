---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationRow from '../../components/PublicationRow.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
	publications,
	PUBLICATION_TYPE_ORDER as TYPE_ORDER,
	PUBLICATION_TYPE_LABEL as TYPE_LABEL,
} from '../../data/publications';

// Group by year (desc); within a year order by type, then title.
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
	year,
	items: publications
		.filter((p) => p.year === year)
		.sort(
			(a, b) =>
				TYPE_ORDER.indexOf(a.type) - TYPE_ORDER.indexOf(b.type) ||
				a.title.localeCompare(b.title),
		),
}));

// Only show filter chips for types that actually appear, in canonical order.
const presentTypes = TYPE_ORDER.filter((t) =>
	publications.some((p) => p.type === t),
);
const chips = [
	{ value: 'all', label: 'All' },
	...presentTypes.map((t) => ({ value: t, label: TYPE_LABEL[t] })),
];
---

<BaseLayout
	title="Publications"
	description="Journal articles, conference papers, technical reports, self-published studies, presentations, and posters."
>
	<h1 class="text-3xl font-semibold">Publications</h1>
	<p class="mt-1 max-w-[640px] font-sans text-[15px] leading-relaxed text-muted">
		Journal articles, conference papers, technical reports, presentations, and
		posters — a selection, more added over time. Self-published studies are not
		refereed and are marked where they were drafted with AI assistance.
	</p>

	<div class="mt-6 border-b border-rule pb-2.5">
		<FilterBar chips={chips} target="#pub-list .pub-row" attr="data-type" groups="#pub-list .pub-year" label="Filter publications by type" />
	</div>

	<div id="pub-list">
		{
			byYear.map((group) => (
				<section class="pub-year" data-year={group.year}>
					<h2 class="mt-7 border-b border-rule pb-1 font-sans text-sm font-semibold text-muted">
						{group.year}
					</h2>
					{group.items.map((pub) => (
						<PublicationRow pub={pub} />
					))}
				</section>
			))
		}
	</div>
</BaseLayout>
