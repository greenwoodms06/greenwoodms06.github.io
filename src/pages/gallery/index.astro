---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { pinnedThenByDate } from '../../lib/content';

// Link-out only (decided 2026-09-02): one optimized thumbnail per piece, the
// full-size work stays where it lives — ArtStation, YouTube, and the like.
const items = pinnedThenByDate(await getCollection('gallery'), 'date');
---

<BaseLayout title="Gallery" description="Artwork, renders, and video — shown here, hosted where they live.">
	<h1 class="text-2xl font-bold">Gallery</h1>
	<p class="mt-1 text-zinc-600">
		Artwork, renders, and video. Each one links out to where it lives.
	</p>
	{
		items.length === 0 ? (
			<p class="mt-6 text-sm text-zinc-500">Nothing here yet.</p>
		) : (
			<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{items.map((g) => (
					<a
						href={g.data.href}
						target="_blank"
						rel="noopener"
						class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200 transition hover:border-accent"
					>
						<Image
							src={g.data.thumbnail}
							alt={g.data.title}
							widths={[400, 800]}
							sizes="(max-width: 768px) 100vw, 33vw"
							class="aspect-[4/3] w-full object-cover"
						/>
						<div class="p-4">
							<div class="flex items-baseline justify-between gap-2 font-mono text-xs text-zinc-500">
								<FormattedDate date={g.data.date} />
								<span>{g.data.source} ↗</span>
							</div>
							<h3 class="mt-1 font-semibold group-hover:text-accent">{g.data.title}</h3>
							{g.data.blurb && <p class="mt-1 text-sm text-zinc-600">{g.data.blurb}</p>}
						</div>
					</a>
				))}
			</div>
		)
	}
</BaseLayout>
