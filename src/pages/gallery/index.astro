---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { pinnedThenByDate } from '../../lib/content';

// Link-out only (decided 2026-09-02): one optimized thumbnail per piece, the
// full-size work stays where it lives — ArtStation, YouTube, and the like.
const items = pinnedThenByDate(await getCollection('gallery'), 'date');
---

<BaseLayout title="Gallery" description="Artwork, renders, and video — shown here, hosted where they live.">
	<h1 class="text-3xl font-semibold">Gallery</h1>
	<p class="mt-1 font-sans text-[15px] text-muted">
		Artwork, renders, and video. Each one links out to where it lives.
	</p>
	{
		items.length === 0 ? (
			<p class="mt-6 font-sans text-sm text-muted">Nothing here yet.</p>
		) : (
			<div class="mt-8 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
				{items.map((g) => (
					<a href={g.data.href} target="_blank" rel="noopener" class="group flex flex-col gap-2">
						<Image
							src={g.data.thumbnail}
							alt={g.data.title}
							widths={[400, 800]}
							sizes="(max-width: 768px) 100vw, 33vw"
							class="aspect-video w-full border border-rule bg-white object-cover"
						/>
						<div class="flex items-baseline justify-between gap-2 font-mono text-xs text-muted">
							<FormattedDate date={g.data.date} />
							<span class="font-sans uppercase tracking-wider">{g.data.source} ↗</span>
						</div>
						<h3 class="text-[17px] font-semibold leading-snug group-hover:text-accent">{g.data.title}</h3>
						{g.data.blurb && <p class="font-sans text-[13px] leading-snug text-muted">{g.data.blurb}</p>}
					</a>
				))}
			</div>
		)
	}
</BaseLayout>
