---
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import AuthorshipBadge from '../../components/AuthorshipBadge.astro';
import KindBadge from '../../components/KindBadge.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PageViews from '../../components/PageViews.astro';
import { displayTags, readingTime } from '../../lib/content';

export async function getStaticPaths() {
	const posts = (await getCollection('posts')).filter(
		(p) => !p.data.draft || import.meta.env.DEV,
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	relatedProjects,
	authorship,
	kind,
} = post.data;
const related = await getEntries(relatedProjects);
const allTags = displayTags(post);
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article class="prose-measure mx-auto w-full min-w-0">
		<a href="/blog" class="font-sans text-sm text-muted hover:text-accent">← Writing</a>
		<h1 class="mt-3 text-[34px] font-semibold leading-tight tracking-tight">{title}</h1>
		<p class="mt-3 flex flex-wrap items-baseline gap-x-2.5 font-sans text-[13px] text-muted">
			<span class="font-mono"><FormattedDate date={pubDate} /></span>
			<span>·</span>
			<KindBadge kind={kind} />
			<span>·</span>
			<span>{minutes} min read</span>
			{
				updatedDate && (
					<>
						<span>·</span>
						<span>updated <FormattedDate date={updatedDate} /></span>
					</>
				)
			}
			<PageViews divider />
		</p>
		<AuthorshipBadge authorship={authorship} variant="note" />
		<TableOfContents headings={headings} />
		{
			heroImage && (
				<Image
					src={heroImage}
					alt={title}
					widths={[800, 1200, 1800, 2400]}
					class="mt-8 border border-rule bg-white"
				/>
			)
		}
		<div class="prose mt-8 max-w-none">
			<Content />
		</div>

		<script>
			// Make article images expandable — click opens the loaded resolution in a new tab.
			document
				.querySelectorAll<HTMLImageElement>('article img')
				.forEach((img) => {
					if (img.closest('a')) return;
					const a = document.createElement('a');
					a.href = img.currentSrc || img.src;
					a.target = '_blank';
					a.rel = 'noopener';
					a.title = 'Open full size';
					a.style.cursor = 'zoom-in';
					a.style.display = 'block';
					img.parentNode?.insertBefore(a, img);
					a.appendChild(img);
				});
		</script>
		{
			allTags.length > 0 && (
				<div class="mt-10 flex flex-wrap gap-x-3 gap-y-1 font-sans text-sm text-muted">
					{allTags.map((t) => (
						<a href={`/tags/${t}`} class="hover:text-accent">
							#{t}
						</a>
					))}
				</div>
			)
		}
		{
			related.length > 0 && (
				<div class="mt-8 border-t border-rule pt-4">
					<h2 class="font-sans text-[11px] font-semibold uppercase tracking-wider text-muted">Related projects</h2>
					<ul class="mt-2 flex flex-col gap-1">
						{related.map((p) => (
							<li>
								<a href={`/projects/${p.id}`} class="text-accent hover:underline">
									{p.data.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
	</article>
</BaseLayout>
