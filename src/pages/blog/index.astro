---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import {
	pinnedThenByDate,
	isPublished,
	isWriting,
	WRITING_KINDS,
	KIND_LABEL,
} from '../../lib/content';

// Notes are timeline-only (see lib/content.ts); the index lists the rest.
const posts = pinnedThenByDate(
	(await getCollection('posts')).filter(
		(p) => isPublished(p) && isWriting(p.data.kind),
	),
	'pubDate',
);

const chips = [
	{ value: 'all', label: 'All' },
	...WRITING_KINDS.map((k) => ({ value: k, label: `${KIND_LABEL[k]}s` })),
];
---

<BaseLayout
	title="Writing"
	description="Essays, devlogs, and how-tos — the occasional rabbit hole."
>
	<h1 class="text-2xl font-bold">Writing</h1>
	<p class="mt-1 text-zinc-600">
		Essays, devlogs, and how-tos — the occasional rabbit hole.
	</p>

	<div class="mt-5 flex gap-2" role="group" aria-label="Filter writing by kind">
		{
			chips.map((c) => (
				<button
					type="button"
					data-filter={c.value}
					aria-pressed={c.value === 'all' ? 'true' : 'false'}
					class="kind-chip rounded-full border border-zinc-300 px-3 py-1 text-sm transition hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
				>
					{c.label}
				</button>
			))
		}
	</div>

	<div class="mt-4" id="writing-list">
		{posts.map((p) => <PostListItem post={p} />)}
	</div>
</BaseLayout>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.kind-chip');
	const items = document.querySelectorAll<HTMLElement>('#writing-list [data-kind]');
	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const want = chip.dataset.filter;
			chips.forEach((c) =>
				c.setAttribute('aria-pressed', String(c === chip)),
			);
			items.forEach((el) => {
				const show = want === 'all' || el.dataset.kind === want;
				el.classList.toggle('hidden', !show);
			});
		});
	});
</script>
