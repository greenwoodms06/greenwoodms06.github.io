---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
	pinnedThenByDate,
	isPublished,
	isWriting,
	WRITING_KINDS,
	KIND_LABEL,
} from '../../lib/content';

// Notes are timeline-only (see lib/content.ts); the index lists the rest.
const posts = pinnedThenByDate(
	(await getCollection('posts')).filter(
		(p) => isPublished(p) && isWriting(p.data.kind),
	),
	'pubDate',
);

const chips = [
	{ value: 'all', label: 'All' },
	...WRITING_KINDS.map((k) => ({ value: k, label: `${KIND_LABEL[k]}s` })),
];
---

<BaseLayout
	title="Writing"
	description="Essays, devlogs, and how-tos — the occasional rabbit hole."
>
	<h1 class="text-3xl font-semibold">Writing</h1>
	<p class="mt-1 font-sans text-[15px] text-muted">
		Essays, devlogs, and how-tos — the occasional rabbit hole.
	</p>
	<div class="mt-6 border-b border-rule pb-2.5">
		<FilterBar chips={chips} target="#writing-list [data-kind]" attr="data-kind" label="Filter writing by kind" />
	</div>
	<div class="mt-2" id="writing-list">
		{posts.map((p) => <PostListItem post={p} />)}
	</div>
</BaseLayout>
