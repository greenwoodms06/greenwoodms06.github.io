---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import bioPhoto from '../assets/bio-photo.png';
import { SOCIALS } from '../consts';
---

<BaseLayout title="About" description="Who I am and what I work on.">
	<div class="prose-measure mx-auto">
		<div class="flex items-center gap-5">
			<Image
				src={bioPhoto}
				alt="Scott Greenwood"
				width={192}
				class="h-24 w-24 rounded-full border border-rule object-cover"
			/>
			<div>
				<h1 class="text-3xl font-semibold">Scott Greenwood</h1>
				<p class="mt-1 font-sans text-[15px] text-muted">
					nuclear sims · graphics · 3D printing · code
				</p>
			</div>
		</div>
		<div class="prose mt-8 max-w-none">
			<p>
				Hi — I'm Scott. I build things across nuclear thermal-hydraulics,
				simulation, graphics, and 3D printing, and I write up the interesting
				bits here. This site is where the side projects piling up finally get a
				home.
			</p>
			<p>
				Most of my code lives on <a href={SOCIALS.github}>GitHub</a>. Videos are
				on <a href={SOCIALS.youtube}>my YouTube channel</a> and, for the work
				ones, the <a href={SOCIALS.youtubeVarsa}>ORNL-VARSA</a> channel; the{' '}
				<a href="/gallery">gallery</a> lists them. Poke around the{' '}
				<a href="/projects">projects</a> or the <a href="/blog">writing</a>.
			</p>
		</div>
	</div>
</BaseLayout>
