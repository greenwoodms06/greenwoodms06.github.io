---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorshipBadge from '../../components/AuthorshipBadge.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PageViews from '../../components/PageViews.astro';
import {
	displayTags,
	isPublished,
	sortByDateDesc,
	KIND_LABEL,
} from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((p) => ({
		params: { slug: p.id },
		props: { project: p },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { title, summary, thumbnail, repo, demo, authorship, status, date, updatedDate } =
	project.data;
const allTags = displayTags(project);
const statusLabel: Record<string, string> = { wip: 'WIP', active: 'Active', archived: 'Archived' };
// One-way wiring: posts name their projects; this list is derived, never typed.
const writing = sortByDateDesc(
	(await getCollection('posts')).filter(
		(p) =>
			isPublished(p) &&
			p.data.relatedProjects.some((r) => r.id === project.id),
	),
	'pubDate',
);
---

<BaseLayout title={title} description={summary} image={thumbnail}>
	<article class="prose-measure mx-auto w-full min-w-0">
		<a href="/projects" class="font-sans text-sm text-muted hover:text-accent">← Projects</a>
		<h1 class="mt-3 text-[34px] font-semibold leading-tight tracking-tight">{title}</h1>
		<p class="mt-3 text-[18px] leading-relaxed text-muted">{summary}</p>
		<p class="mt-3 flex flex-wrap items-baseline gap-x-2.5 font-sans text-[13px] text-muted">
			<span class="uppercase tracking-wider text-[11px]">{statusLabel[status] ?? status}</span>
			<span>·</span>
			<span>since <span class="font-mono"><FormattedDate date={date} /></span></span>
			{
				updatedDate && (
					<>
						<span>·</span>
						<span>updated <FormattedDate date={updatedDate} /></span>
					</>
				)
			}
			<PageViews divider />
		</p>
		{
			(repo || demo) && (
				<div class="mt-5 flex flex-wrap gap-3 font-sans text-sm">
					{repo && (
						<a
							href={repo}
							class="inline-flex items-center rounded-sm bg-accent px-3.5 py-1.5 font-medium text-white transition hover:opacity-90"
						>
							View repo ↗
						</a>
					)}
					{demo && (
						<a
							href={demo}
							class="inline-flex items-center rounded-sm border border-accent px-3.5 py-1.5 font-medium text-accent transition hover:bg-accent/10"
						>
							Live demo ↗
						</a>
					)}
				</div>
			)
		}
		<div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 font-sans text-sm text-muted">
			{
				allTags.map((t) => (
					<a href={`/tags/${t}`} class="hover:text-accent">
						#{t}
					</a>
				))
			}
		</div>
		<AuthorshipBadge authorship={authorship} variant="note" />
		<TableOfContents headings={headings} />
		{
			thumbnail && (
				<Image
					src={thumbnail}
					alt={title}
					widths={[800, 1200, 1800, 2400]}
					class="mt-8 border border-rule bg-white"
				/>
			)
		}
		<div class="prose mt-8 max-w-none">
			<Content />
		</div>

		<script>
			// Make article images expandable — click opens the loaded resolution in a new tab.
			document
				.querySelectorAll<HTMLImageElement>('article img')
				.forEach((img) => {
					if (img.closest('a')) return;
					const a = document.createElement('a');
					a.href = img.currentSrc || img.src;
					a.target = '_blank';
					a.rel = 'noopener';
					a.title = 'Open full size';
					a.style.cursor = 'zoom-in';
					a.style.display = 'block';
					img.parentNode?.insertBefore(a, img);
					a.appendChild(img);
				});
		</script>
		{
			writing.length > 0 && (
				<div class="mt-10 border-t border-rule pt-4">
					<h2 class="font-sans text-[11px] font-semibold uppercase tracking-wider text-muted">Writing about this</h2>
					<ul class="mt-3 flex flex-col gap-4">
						{writing.map((p) => (
							<li>
								<div class="flex flex-wrap items-baseline gap-x-3">
									<a href={`/blog/${p.id}`} class="text-[17px] font-semibold hover:text-accent">
										{p.data.title}
									</a>
									<span class="font-mono text-xs text-muted">
										<FormattedDate date={p.data.pubDate} /> · {KIND_LABEL[p.data.kind]}
									</span>
								</div>
								{p.data.description && (
									<p class="mt-0.5 font-sans text-sm leading-relaxed text-muted">{p.data.description}</p>
								)}
							</li>
						))}
					</ul>
				</div>
			)
		}
	</article>
</BaseLayout>
